<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="13dp">
        <ImageButton
            android:id="@+id/btnBackOrderDetail"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="12dp"
            android:background="@drawable/bg_top_button"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/brand_dark"
            android:contentDescription="@string/action_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            android:text="Chi tiết đơn hàng"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/line_soft"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:id="@+id/tvOrderDetailStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chờ xác nhận"
                        android:textColor="@color/brand_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvOrderDetailId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="FM-0000"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvOrderDetailDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Ngày tạo"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/line_soft"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sản phẩm đã chọn"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <LinearLayout
                        android:id="@+id/orderDetailItemsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tổng đơn (demo)"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvOrderDetailTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 đ"
                            android:textStyle="bold"
                            android:textSize="23sp"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/line_soft"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông tin nhận hàng"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/tvOrderDetailRecipient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Người nhận"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/tvOrderDetailPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Số điện thoại"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvOrderDetailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Địa chỉ"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvOrderDetailNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Ghi chú"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/line_soft"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="17dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thanh toán"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:id="@+id/tvOrderDetailPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Thanh toán demo"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Không có tiền hoặc đơn giao hàng thật. Không chia sẻ dữ liệu nhạy cảm trong bài thực hành."
                        android:textSize="12sp"
                        android:textColor="@color/price_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:background="@color/surface_white"
        android:elevation="9dp">
        <LinearLayout
            android:id="@+id/orderDetailEditActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditOrder"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Sửa đơn"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelOrder"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:text="Hủy đơn"
                android:textAllCaps="false"
                android:textColor="@color/price_color"
                app:cornerRadius="14dp"
                app:strokeColor="@color/line_soft" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmOrderDemo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:text="Xác nhận thanh toán mô phỏng"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="@color/line_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShopFromOrderDetail"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Tiếp tục khám phá sản phẩm"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary" />
    </LinearLayout>
</LinearLayout>
