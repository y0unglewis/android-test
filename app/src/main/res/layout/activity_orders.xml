<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="15dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBackOrders"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="12dp"
            android:background="@drawable/bg_top_button"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/brand_dark"
            android:contentDescription="@string/action_back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đơn hàng của tôi"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvOrdersCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="0 đơn"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="22dp"
        android:paddingBottom="12dp"
        android:text="Lịch sử chỉ lưu trên máy và thuộc tài khoản demo đang đăng nhập."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ordersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingBottom="20dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/ordersEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:background="@drawable/bg_fruit_icon"
                android:src="@drawable/fruit_mango"
                android:padding="16dp"
                android:contentDescription="@string/product_image_description" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Chưa có đơn hàng"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="19sp"
                android:gravity="center" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Khám phá sản phẩm và tạo đơn thử nhé!"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShopFromOrders"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="Xem sản phẩm"
                android:textAllCaps="false"
                app:cornerRadius="15dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
