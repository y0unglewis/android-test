<?xml version="1.0" encoding="utf-8"?>
<!-- Dùng khi xem lại sản phẩm trước đặt hàng và khi chỉnh sửa đơn chưa xử lý. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/imgCheckoutProduct"
            android:layout_width="54dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_fruit_icon"
            android:padding="5dp"
            android:src="@drawable/fruit_apple"
            android:contentDescription="@string/product_image_description" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvCheckoutProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên trái cây"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/tvCheckoutProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 đ/kg"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvCheckoutLineTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="0 đ"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Số lượng"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <ImageButton
            android:id="@+id/btnCheckoutDecrease"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_top_button"
            android:src="@drawable/ic_quantity_minus"
            android:tint="@color/brand_dark"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Giảm số lượng sản phẩm"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvCheckoutQty"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <ImageButton
            android:id="@+id/btnCheckoutIncrease"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_top_button"
            android:src="@drawable/ic_quantity_plus"
            android:tint="@color/brand_dark"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Tăng số lượng sản phẩm"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckoutRemove"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Xóa"
            android:textAllCaps="false"
            android:textColor="@color/price_color"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:background="@color/line_soft" />
</LinearLayout>
