<?xml version="1.0" encoding="utf-8"?>
<!-- Một đánh giá thực do tài khoản demo trên thiết bị gửi. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/surface_warm"
    app:cardCornerRadius="15dp"
    app:strokeColor="@color/line_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvReviewAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Người đánh giá"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/tvReviewStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★★★★★"
                android:textSize="15sp"
                android:textColor="@color/price_color" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvReviewDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ngày đánh giá"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Nội dung đánh giá"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteOwnReview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:text="Xóa đánh giá của tôi"
            android:textAllCaps="false"
            android:textColor="@color/price_color"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
