<?xml version="1.0" encoding="utf-8"?>
<!-- Fresh Market Home: giữ nguyên ID để HomeActivity vẫn dùng Firestore/Intent như bài cũ. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header: lời chào từ SharedPreferences, Profile và Logout. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FRESH  /  MARKET"
                android:textColor="@color/brand_primary"
                android:letterSpacing="0.16"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Xin chào, bạn!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_top_button"
            android:src="@drawable/ic_profile"
            android:padding="12dp"
            android:tint="@color/brand_dark"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_profile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:text="Đăng xuất"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/brand_dark"
            app:backgroundTint="@color/brand_soft"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Hero: không có tính năng mới, CTA vẫn gọi openProducts(-1). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_highlight">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_brand_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="TƯƠI MỚI MỖI NGÀY"
                android:letterSpacing="0.04"
                android:textStyle="bold"
                android:textSize="9sp"
                android:textColor="@color/brand_dark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Trái cây tươi\nmỗi ngày."
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Khám phá trái cây và giá tham khảo."
                android:textSize="12sp"
                android:textColor="@color/hero_text_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenProducts"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="Xem sản phẩm"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/brand_dark"
                app:backgroundTint="@color/white"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="78dp"
            android:layout_height="94dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_fruit_icon"
            android:src="@drawable/fruit_apple"
            android:scaleType="fitCenter"
            android:contentDescription="@string/product_image_description" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vườn trái cây"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chọn một loại để xem thông tin"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANH MỤC"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:textStyle="bold"
            android:textColor="@color/chip_text"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_brand_chip" />
    </LinearLayout>

    <!-- Trạng thái tải dữ liệu cho người dùng: không tạo request Firebase mới. -->
    <TextView
        android:id="@+id/tvFruitStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:text="Đang tải danh sách trái cây..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Home và Detail dùng chung ProductAdapter, mỗi item có ảnh, tên, giá. -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp" />

    <!-- Giữ nguyên hai tab và listener trong HomeActivity. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="66dp"
        android:background="@drawable/bg_nav_surface"
        android:elevation="12dp"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint" />
</LinearLayout>
