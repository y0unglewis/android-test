<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hồ sơ cá nhân: đọc username từ user_session, không có backend. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Thanh tiêu đề và nút quay lại Home. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBackProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_top_button"
                android:scaleType="centerInside"
                android:contentDescription="@string/action_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Hồ sơ cá nhân"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Avatar minh họa dùng chung icon người dùng với nút ở Home. -->
        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="36dp"
            android:padding="26dp"
            android:background="@drawable/bg_fruit_icon"
            android:src="@drawable/ic_profile"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_profile" />

        <!-- TextView này sẽ được Java điền tên user hiện tại. -->
        <TextView
            android:id="@+id/tvProfileUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Tên người dùng"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- Card thông tin hồ sơ; dữ liệu được đọc từ SharedPreferences. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_auth_card"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THÔNG TIN TÀI KHOẢN"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/brand_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tên đăng nhập"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvProfileUsernameDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tên người dùng"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
