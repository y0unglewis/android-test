<?xml version="1.0" encoding="utf-8"?>
<!-- Login: ScrollView giúp nội dung cuộn khi bàn phím mở hoặc màn hình nhỏ. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/page_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp"
        android:minHeight="600dp">

        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center_horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_fruit_icon"
            android:src="@drawable/fruit_apple"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Chào mừng trở lại"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Đăng nhập để khám phá các loại trái cây"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_auth_card"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên đăng nhập"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />
            <!-- Java đọc giá trị username từ EditText bằng getText(). -->
            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:hint="Nhập tên đăng nhập"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:autofillHints="username" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Mật khẩu"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />
            <!-- textPassword thiết lập ô nhập mật khẩu, không tự lưu mật khẩu. -->
            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:hint="Nhập mật khẩu"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:autofillHints="password" />

            <!-- LoginActivity đăng ký setOnClickListener() để xử lý đăng nhập. -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="@color/brand_primary"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Tài khoản thử: demo / 123456"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="26dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản?  "
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
            <!-- Nhấn TextView này sẽ mở RegisterActivity bằng Intent. -->
            <TextView
                android:id="@+id/tvGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
