<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Detail • Danh sách sản phẩm" android:textSize="23sp"
        android:textStyle="bold" android:textColor="#222222" android:layout_marginBottom="8dp" />

    <Button android:id="@+id/btnBackHome" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="← Về Home" />

    <ListView android:id="@+id/listViewProducts" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:divider="@android:color/transparent" android:dividerHeight="0dp" />
</LinearLayout>
